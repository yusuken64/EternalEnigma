    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>KEYBOARD / MOUSE</b>

    <b>Dungeon / town</b>

    Move: WASD / arrows
    (8 directions)

    Attack / interact / talk: Space

    Inventory: Q   |   Skills:
    R

    Ally orders (dungeon): E

    Next ally: Tab*

    Dungeon map: M

    Wait
    one action: . (period)

    Turn in place: hold Shift + direction

    Settings:
    Esc or Options button


    <b>Overworld / town party</b>

    Overworld interact
    / unlock: Enter

    Town party selection: P

    Click travel buttons to interact
    / warp


    <b>Menus</b>

    Navigate: WASD / arrows

    Confirm: Space /
    Enter / click

    Back: Esc


    <b>Watching autoplay</b>

    Show / hide
    panel: F8

    Gameplay input opens stop prompt

    Take control: T | Keep watching:
    Esc

    Return to main menu: Enter'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
